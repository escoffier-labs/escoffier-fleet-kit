---
// Shared "More from Escoffier Labs" cross-link section for the fleet.
//
// SOURCE OF TRUTH: escoffier-fleet-kit/fleet/FleetLinks.astro
// Copied into each *-site repo as src/components/FleetLinks.astro by bin/fleet-sync.sh.
// Pairs with fleet/fleet.ts (the registry). Prefer editing the kit, then fleet-sync.
//
// Layout: borderless link index (no shelf cards). Matches the brigade.tools
// product-home anti-slop pattern: name + job on a hairline row, centered column.
import { FLEET, FLEET_HUB, type FleetTool } from '../lib/fleet.ts';

interface Props {
  /** Site key from fleet.ts (e.g. 'memory-doctor-site') to exclude from the list. */
  current?: string;
}
const { current = '' } = Astro.props as Props;
const others: FleetTool[] = FLEET.filter((t) => t.key !== current);
const hubHost = FLEET_HUB.url.replace(/^https?:\/\//, '');
---
<section class="fleet-links" aria-label="More from Escoffier Labs">
  <div class="fleet-wrap">
    <p class="fleet-eyebrow">More from Escoffier Labs</p>
    <h2 class="fleet-title">Local-first tools for AI coding agents</h2>
    <p class="fleet-lede">
      One kitchen, one brigade. Each tool does one job well, and they share one reviewed source of
      memory, config, and receipts.
    </p>
    <div class="fleet-index">
      {others.map((t) => (
        <a href={t.url}>
          <span class="fleet-name">{t.name}</span>
          <span class="fleet-job">{t.blurb}</span>
        </a>
      ))}
    </div>
    <p class="fleet-hub">
      <a href={FLEET_HUB.url}>See the whole fleet at {hubHost} →</a>
    </p>
  </div>
</section>

<style>
  .fleet-links {
    padding: 52px 0;
    border-top: 1px solid var(--hairline);
    text-align: center;
  }
  .fleet-wrap {
    max-width: 40rem;
    margin: 0 auto;
    padding: 0 22px;
    text-align: center;
  }
  .fleet-eyebrow {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin: 0 0 12px;
  }
  .fleet-title {
    font-family: "Inter Variable", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.25rem, 2.3vw, 1.55rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    color: var(--text);
  }
  .fleet-lede {
    margin: 0 auto 8px;
    max-width: 36rem;
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.55;
    text-align: center;
  }
  .fleet-index {
    border-top: 1px solid var(--hairline);
    margin-top: 24px;
    text-align: left;
  }
  .fleet-index a {
    display: grid;
    grid-template-columns: minmax(7.5rem, 11rem) 1fr;
    gap: 12px 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
    color: inherit;
    align-items: baseline;
  }
  .fleet-index a:hover .fleet-name {
    color: var(--accent);
  }
  .fleet-name {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text);
  }
  .fleet-job {
    font-size: 0.92rem;
    color: var(--text-muted);
    max-width: 48ch;
  }
  .fleet-hub {
    margin: 28px 0 0;
    font-size: 0.9rem;
    text-align: center;
  }
  .fleet-hub a {
    color: var(--accent);
    text-decoration: none;
  }
  .fleet-hub a:hover {
    text-decoration: underline;
  }
  @media (max-width: 560px) {
    .fleet-index a {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
